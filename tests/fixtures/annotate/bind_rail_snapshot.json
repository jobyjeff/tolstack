{
 "about": "The annotator's bind-mode rail (.an__rail outerHTML, HTML comments removed), on ?mock=1 at 1600x1000: at boot, and after `goto demo_system demo_edge_untraced`. Captured from integration 9a29acd, BEFORE handoff the_sweep_rail_shows_the_mechanism, so the browser tier can hold that the sweep rail left bind mode's DOM byte-identical. A deliberate change to the bind rail rewrites it: node scripts/run_viewer_browser_tests.mjs --only \"annotate sweep rail\" --write-bind-rail-snapshot.",
 "boot": "<aside class=\"an__rail\">\n      \n      <details id=\"auto-setup\" class=\"an__auto\">\n        <summary>Set up automatically</summary>\n        <div id=\"auto-setup-body\" class=\"an__auto-body\"><label class=\"an__setting\" title=\"arriving from the stack viewer opens the topology it came from\"><input type=\"checkbox\">Topology</label><label class=\"an__setting\" title=\"arriving from the stack viewer opens the study it came from\"><input type=\"checkbox\">Study</label><label class=\"an__setting\" title=\"arriving from the stack viewer shows only the parts that element touches\"><input type=\"checkbox\">Parts</label></div>\n      </details>\n\n      <label class=\"an__label\">topology</label>\n      <select id=\"topology-select\" title=\"Demo mechanism\"><option value=\"demo_system\">Demo mechanism</option><option value=\"demo_studyless\">Demo topology without studies</option></select>\n      <label class=\"an__label\">study</label>\n      <select id=\"study-select\" title=\"Demo study\"><option value=\"demo_study\">Demo study</option></select>\n      \n      <div id=\"rail-filter\" class=\"an__filter\" style=\"display:none\"></div>\n      <ol id=\"element-list\" class=\"element-list\"><li class=\"el-row el-row--unbound\" title=\"Demo traced edge\"><span class=\"el-row__name\">Demo traced edge</span><span class=\"alertbadge\" tabindex=\"0\" aria-label=\"No face is bound to this element yet.\"><svg class=\"alertbadge__mark\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 3L22.4 21H1.6Z M10.9 9h2.2v5.6h-2.2z M10.9 16.4h2.2v2.2h-2.2z\" fill-rule=\"evenodd\" fill=\"currentColor\"></path></svg></span></li><li class=\"el-row el-row--bound\" title=\"Demo untraced edge\"><span class=\"el-row__name\">Demo untraced edge</span></li><li class=\"el-row el-row--owner_not_in_set\" title=\"Demo owner-not-in-set edge\"><span class=\"el-row__name\">Demo owner-not-in-set edge</span><span class=\"alertbadge\" tabindex=\"0\" aria-label=\"Recorded as belonging to a part that is not in this set, so no face here can stand for it.\"><svg class=\"alertbadge__mark\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 3L22.4 21H1.6Z M10.9 9h2.2v5.6h-2.2z M10.9 16.4h2.2v2.2h-2.2z\" fill-rule=\"evenodd\" fill=\"currentColor\"></path></svg></span></li></ol>\n\n      \n      <label class=\"an__label\">parts with a 3D model</label>\n      <ul id=\"parts-panel\" class=\"parts-panel\"><li class=\"part-row part-row--head\"><span class=\"part-row__label\" title=\"In this model\">In this model</span><input type=\"checkbox\" title=\"show or hide every part in this model\"></li><li class=\"part-row\"><span class=\"part-row__label\" title=\"Demo part (synthetic, mock mode)\n000000000000\">Demo part (synthetic, mock mode)</span><input type=\"checkbox\" title=\"show/hide in the 3D view\"><button title=\"show only this part\" aria-pressed=\"false\">Isolate</button><button class=\"part-row__member\">Remove</button></li><li><details class=\"parts-other\"><summary>Other parts (2)</summary><ul class=\"parts-panel\"><li class=\"part-row\"><span class=\"part-row__label\" title=\"Demo bracket (synthetic, mock mode)\n111111111111\">Demo bracket (synthetic, mock mode)</span><input type=\"checkbox\" title=\"show/hide in the 3D view\"><button title=\"show only this part\" aria-pressed=\"false\">Isolate</button><button class=\"part-row__member\">Add</button><span class=\"part-row__note\">no position in the assembly — shown at its own origin</span></li><li class=\"part-row\"><span class=\"part-row__label\" title=\"Demo plate (synthetic, mock mode)\n222222222222\">Demo plate (synthetic, mock mode)</span><input type=\"checkbox\" title=\"show/hide in the 3D view\"><button title=\"show only this part\" aria-pressed=\"false\">Isolate</button><button class=\"part-row__member\">Add</button><span class=\"part-row__note\">no position in the assembly — shown at its own origin</span></li></ul></details></li></ul>\n    </aside>",
 "goto": "<aside class=\"an__rail\">\n      \n      <details id=\"auto-setup\" class=\"an__auto\">\n        <summary>Set up automatically</summary>\n        <div id=\"auto-setup-body\" class=\"an__auto-body\"><label class=\"an__setting\" title=\"arriving from the stack viewer opens the topology it came from\"><input type=\"checkbox\">Topology</label><label class=\"an__setting\" title=\"arriving from the stack viewer opens the study it came from\"><input type=\"checkbox\">Study</label><label class=\"an__setting\" title=\"arriving from the stack viewer shows only the parts that element touches\"><input type=\"checkbox\">Parts</label></div>\n      </details>\n\n      <label class=\"an__label\">topology</label>\n      <select id=\"topology-select\" title=\"Demo mechanism\"><option value=\"demo_system\">Demo mechanism</option><option value=\"demo_studyless\">Demo topology without studies</option></select>\n      <label class=\"an__label\">study</label>\n      <select id=\"study-select\" title=\"Demo study\"><option value=\"demo_study\">Demo study</option></select>\n      \n      <div id=\"rail-filter\" class=\"an__filter\" style=\"display: block;\"><span class=\"an__filter-note\">Showing only: Demo untraced edge</span><button class=\"an__filter-clear\" title=\"list every element in the study and every installed part again\">Show all</button></div>\n      <ol id=\"element-list\" class=\"element-list\"><li class=\"el-row el-row--bound selected\" title=\"Demo untraced edge\"><span class=\"el-row__name\">Demo untraced edge</span></li></ol>\n\n      \n      <label class=\"an__label\">parts with a 3D model</label>\n      <ul id=\"parts-panel\" class=\"parts-panel\"><li class=\"part-row part-row--head\"><span class=\"part-row__label\" title=\"In this model\">In this model</span><input type=\"checkbox\" title=\"show or hide every part in this model\"></li><li class=\"part-row\"><span class=\"part-row__label\" title=\"Demo part (synthetic, mock mode)\n000000000000\">Demo part (synthetic, mock mode)</span><input type=\"checkbox\" title=\"show/hide in the 3D view\"><button title=\"show the other parts again\" aria-pressed=\"true\" class=\"is-pressed\">Isolate</button><button class=\"part-row__member\">Remove</button></li><li><details class=\"parts-other\"><summary>Other parts (2)</summary><ul class=\"parts-panel\"><li class=\"part-row\"><span class=\"part-row__label\" title=\"Demo bracket (synthetic, mock mode)\n111111111111\">Demo bracket (synthetic, mock mode)</span><input type=\"checkbox\" title=\"show/hide in the 3D view\"><button title=\"show only this part\" aria-pressed=\"false\">Isolate</button><button class=\"part-row__member\">Add</button><span class=\"part-row__note\">no position in the assembly — shown at its own origin</span></li><li class=\"part-row\"><span class=\"part-row__label\" title=\"Demo plate (synthetic, mock mode)\n222222222222\">Demo plate (synthetic, mock mode)</span><input type=\"checkbox\" title=\"show/hide in the 3D view\"><button title=\"show only this part\" aria-pressed=\"false\">Isolate</button><button class=\"part-row__member\">Add</button><span class=\"part-row__note\">no position in the assembly — shown at its own origin</span></li></ul></details></li></ul>\n    </aside>"
