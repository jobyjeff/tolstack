# NOTE: shipped as `gitignore` (no dot); `forge new-repo` renames it to
# `.gitignore` when stamping. Keeping the dot off inside forge stops git from
# interpreting this file against the template's own tracked stubs.

# Python
__pycache__/
*.py[cod]
venv/
venv-win/
*.egg-info/
.pytest_cache/

# Node — TEST TOOLING ONLY (forge CONVENTIONS.md §7). apps/ frontends stay
# build-free classic scripts; package.json + the lockfile are tracked, the
# installed tree is not.
node_modules/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# DELIBERATELY NOT IGNORED: *.backup / *.bak / *.orig / *~ (2026-08-12,
# restore_viewer_readme). An editor artefact appearing beside a modified tracked
# file is the cheapest tell that a non-git writer owns that file -- it is what
# made the Ghostwriter window rewriting apps/viewer/README.md diagnosable at all.
# Ignoring the pattern buys quiet in `git status` and pays with that signal.
# Delete the artefact when you see it; treat its re-appearance as the alarm.
# See docs/sessions/lessons/LESSONS_20260812_restore_viewer_readme.md.

# Temporary
tmp/
temp/
*.tmp
*.log

# Agent bootstrap (ephemeral, replaced per-session by dispatch).
CLAUDE.md

# dispatch runtime dir (per-repo state + generated launch scripts).
.dispatch/

# data/ layout (forge CONVENTIONS.md): data contents are gitignored (fs is
# canonical, absence from git is not data loss); directory skeletons and the
# provenance docs beside them are tracked.
#
# DIRECTORY-DESCENT RULE -- read this before editing anything below. Git does
# not descend into an excluded *directory*, so a `!` negation underneath a rule
# that excluded the directory itself is unreachable no matter where you put it.
# A `*` never crosses `/`, so `data/*` matches `data/inbox` (the directory), and
# `data/inbox/*` matches `data/inbox/specs` (the directory). Each level you want
# a tracked file at must therefore be re-included **by name** before its own
# contents are excluded: exclude, re-include the dir, exclude its contents,
# negate the docs. Verify every edit with `git check-ignore -v <path>` and
# `git ls-files data/` -- never by eye.

# Ignore-by-default at the top level, then descend into the three standard
# streams. A new top-level `data/` child is ignored until it is listed here.
data/*
!data/inbox/
!data/runs/
!data/projections/

data/inbox/*
!data/inbox/.gitkeep
# Per-stream skeletons.
!data/inbox/specs/
data/inbox/specs/*
!data/inbox/specs/README.md
!data/inbox/tolerance_stacks/
data/inbox/tolerance_stacks/*
!data/inbox/tolerance_stacks/.gitkeep
!data/inbox/tolerance_stacks/PROVENANCE.md
!data/inbox/drawings/
data/inbox/drawings/*
!data/inbox/drawings/.gitkeep
!data/inbox/drawings/PROVENANCE.md

data/runs/*
!data/runs/.gitkeep
data/runs.jsonl
data/projections/*
!data/projections/.gitkeep
