# NOTE: shipped as `gitignore` (no dot); `forge new-repo` renames it to
# `.gitignore` when stamping. Keeping the dot off inside forge stops git from
# interpreting this file against the template's own tracked stubs.

# Python
__pycache__/
*.py[cod]
venv/
venv-win/
*.egg-info/
.pytest_cache/

# Node — TEST TOOLING ONLY (forge CONVENTIONS.md §7). apps/ frontends stay
# build-free classic scripts; package.json + the lockfile are tracked, the
# installed tree is not.
node_modules/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Temporary
tmp/
temp/
*.tmp
*.log

# Agent bootstrap (ephemeral, replaced per-session by dispatch).
CLAUDE.md

# data/ layout (forge CONVENTIONS.md): data contents are gitignored (fs is
# canonical); directory skeletons are tracked via .gitkeep.
data/inbox/*
!data/inbox/.gitkeep
# Per-stream skeletons. `data/inbox/*` excludes the directories themselves, and
# git does not descend into an excluded directory -- so each stream that has a
# tracked doc must be re-included by name, then have its own contents excluded.
!data/inbox/specs/
data/inbox/specs/*
!data/inbox/specs/README.md
!data/inbox/tolerance_stacks/
data/inbox/tolerance_stacks/*
!data/inbox/tolerance_stacks/.gitkeep
!data/inbox/tolerance_stacks/PROVENANCE.md
!data/inbox/drawings/
data/inbox/drawings/*
!data/inbox/drawings/.gitkeep
!data/inbox/drawings/PROVENANCE.md
data/runs/*
!data/runs/.gitkeep
data/runs.jsonl
data/projections/*
!data/projections/.gitkeep
